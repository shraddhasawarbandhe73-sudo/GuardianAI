# Copy this file to .env. Keep .env private and NEVER upload it to GitHub.
# Ring Developer Playground token is short-lived (about 30 minutes).
RING_ACCESS_TOKEN=
RING_API_BASE_URL=https://api.amazonvision.com

# Optional real Amazon Bedrock analysis. Leave blank to use the transparent local fallback.
# Configure AWS credentials separately using AWS CLI / environment variables.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
